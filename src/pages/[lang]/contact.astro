---
import type { Lang } from "../../i18n/content";
import { CONTENT, LANGS, LINKS } from "../../i18n/content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = CONTENT[lang];
const c = t.contact;
const title = `${c.title} — Recep Özgür Mıh`;
---

<Base lang={lang} page="contact" title={title} description={c.lead}>
  <Nav lang={lang} active="contact" />
  <main>
    <section class="sect">
      <div class="wrap">
        <div class="contact-cta band bg-coral px-8 py-20 text-center text-white sm:px-16 sm:py-32">
          <div aria-hidden="true" class="shape h-72 w-72 bg-amber -right-16 -top-16" data-parallax="0.22"></div>
          <div aria-hidden="true" class="shape h-44 w-44 bg-blue -left-10 bottom-6" data-parallax="-0.2"></div>
          <div aria-hidden="true" class="shape h-24 w-24 bg-white/30 right-1/4 bottom-1/3" data-parallax="0.3"></div>

          <div class="relative z-10 mx-auto max-w-2xl text-center">
            <p data-reveal class="kicker mb-4 text-white/80">{c.kicker}</p>
            <h1 data-reveal="title" style="--d:70ms" class="h-hero text-white">{c.title}</h1>
            <p data-reveal style="--d:140ms" class="mx-auto mt-6 max-w-md text-lg text-white/80">{c.lead}</p>

            <div data-reveal style="--d:220ms" class="mt-10 flex flex-wrap items-center justify-center gap-3">
              <a href={`mailto:${c.email}`} data-mascot="contact" data-magnetic class="inline-flex items-center gap-2 rounded-pill bg-white px-7 py-4 text-base font-bold text-fg transition hover:bg-fg hover:text-page">
                {c.ctaEmail} <span class="arrow-nudge">→</span>
              </a>
              <a href={LINKS.github} target="_blank" rel="noopener" data-mascot="github" data-magnetic class="inline-flex items-center gap-2 rounded-pill border border-white/40 px-6 py-4 text-base font-bold text-white transition hover:bg-white/10">{c.ctaGithub} ↗</a>
              <a href={LINKS.linkedin} target="_blank" rel="noopener" data-mascot="linkedin" data-magnetic class="inline-flex items-center gap-2 rounded-pill border border-white/40 px-6 py-4 text-base font-bold text-white transition hover:bg-white/10">{c.ctaLinkedin} ↗</a>
            </div>

            <div data-reveal style="--d:300ms" class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-xs font-semibold text-white/70">
              <a href={`mailto:${c.email}`} class="ul transition hover:text-white">{c.email}</a>
              <span class="hidden sm:inline">·</span>
              <a href={LINKS.cv} target="_blank" rel="noopener" data-mascot="cv" class="ul transition hover:text-white">{c.ctaCV} ↗</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
