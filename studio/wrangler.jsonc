{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recepozgur-content-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-10",
  "routes": [
    {
      "pattern": "studio.recepozgur.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_EMAILS": "recepzgrmh@gmail.com,recep.ozgur.mih@gmail.com",
    "MAX_UPLOAD_BYTES": "10485760",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "GITHUB_REPOSITORY": "recepzgrmh/recepzgrmh.github.io",
    "GITHUB_BRANCH": "main"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recepozgur-content-studio",
      "database_id": "fd529276-9e08-46dc-8156-e6163039d1d1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "recepozgur-content-assets"
    }
  ]
}
