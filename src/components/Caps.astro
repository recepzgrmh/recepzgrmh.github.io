---
import type { Lang, StatTone } from "../i18n/content";
import { CONTENT } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const groups = CONTENT[lang].capabilities;

const accent: Record<StatTone, string> = {
  amber: "bg-amber",
  coral: "bg-coral",
  blue: "bg-blue",
  lime: "bg-lime",
  purple: "bg-purple",
  white: "bg-fg",
  soft: "bg-muted",
};
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {
    groups.map((g, i) => (
      <div
        data-reveal="scale"
        data-spotlight
        style={`--d:${i * 80}ms`}
        class="caps-card group rounded-card2 border border-border bg-surface p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-fg/15 hover:shadow-[0_24px_50px_-26px_rgba(17,17,20,0.3)]"
      >
        <div class="mb-7 flex items-center justify-between">
          <span class={`h-3 w-3 rounded-full ${accent[g.tone]}`}></span>
          <span class="h-px w-10 bg-border transition-colors group-hover:bg-amber"></span>
        </div>
        <h3 class="display text-xl text-fg">{g.title}</h3>
        <ul class="mt-4 flex flex-col gap-2.5">
          {g.items.map((it) => (
            <li class="flex items-start gap-2.5 text-sm text-fg-2">
              <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-amber" />
              {it}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
