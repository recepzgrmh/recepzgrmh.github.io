---
import type { Lang } from "../../i18n/content";
import { LANGS } from "../../i18n/content";
import { ACADEMIC } from "../../i18n/academic";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import AcademicJourney from "../../components/AcademicJourney.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const academic = ACADEMIC[lang];
---

<Base lang={lang} page="academic-life" title={academic.metaTitle} description={academic.metaDescription}>
  <Nav lang={lang} active="academic" />
  <main>
    <AcademicJourney lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
