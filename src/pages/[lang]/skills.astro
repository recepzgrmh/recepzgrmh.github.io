---
import type { Lang, StatTone } from "../../i18n/content";
import { CONTENT, LANGS } from "../../i18n/content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = CONTENT[lang];
const skills = t.skillsPage;
const base = `/${lang}`;
const title = `${skills.kicker} — Recep Özgür Mıh`;

const skillTone: Record<StatTone, string> = {
  amber: "bg-amber",
  coral: "bg-coral",
  blue: "bg-blue",
  lime: "bg-lime",
  purple: "bg-purple",
  white: "bg-surface",
  soft: "bg-soft",
};

const orbitPositions = [
  "left-1/2 top-0 -translate-x-1/2",
  "right-0 top-1/2 -translate-y-1/2",
  "bottom-0 left-1/2 -translate-x-1/2",
  "left-0 top-1/2 -translate-y-1/2",
];
---

<Base lang={lang} page="skills" title={title} description={skills.note}>
  <Nav lang={lang} active="skills" />
  <main>
    <section data-skills-hero class="relative overflow-hidden">
      <div aria-hidden="true" class="shape h-64 w-64 bg-purple/50 -right-12 top-5" data-parallax="0.2"></div>
      <div aria-hidden="true" class="shape h-32 w-32 bg-lime/70 left-[46%] top-20" data-parallax="-0.18"></div>
      <div class="wrap relative z-10 grid min-h-[calc(72svh-76px)] items-center gap-10 py-12 sm:min-h-[calc(78svh-76px)] lg:grid-cols-[1.08fr_0.92fr] lg:py-14">
        <header class="max-w-4xl">
          <p data-reveal class="kicker mb-3 text-amber">{skills.kicker}</p>
          <h1 data-reveal="title" style="--d:70ms" class="h-hero">{skills.title}</h1>
          <p data-reveal style="--d:150ms" class="mt-6 max-w-2xl text-xl leading-relaxed text-fg-2">
            {skills.note}
          </p>
          <div data-reveal style="--d:230ms" class="mt-10 flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-widest text-muted">
            <span class="grid h-8 w-8 place-items-center rounded-full border border-border bg-surface">↓</span>
            {lang === "tr" ? "Derinliği görmek için kaydır" : "Scroll to see the depth"}
          </div>
        </header>

        <div data-reveal="scale" style="--d:180ms" class="skill-orbit mx-auto hidden w-full max-w-[470px] sm:block" aria-hidden="true">
          <div data-skills-orbit-ring class="skill-orbit-ring">
            <div class="skill-orbit-dash"></div>
            {
              t.capabilities.map((capability, index) => (
                <span
                  data-orbit-chip
                  class:list={[
                    "orbit-chip absolute z-10 rounded-pill border border-border bg-surface px-4 py-2 font-mono text-xs font-bold text-fg shadow-sm",
                    orbitPositions[index],
                  ]}
                >
                  {capability.title}
                </span>
              ))
            }
            <div class="skill-orbit-core">
              <span class="font-mono text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-page/55">0 →</span>
              <strong class="display text-2xl text-page">PROD</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section data-skills-depth class="sect relative overflow-hidden border-y border-border bg-surface">
      <div class="wrap grid gap-14 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
        <aside class="relative self-start lg:sticky lg:top-28">
          <div class="absolute -left-4 top-1 hidden h-full w-px bg-border lg:block">
            <span data-skills-progress class="block h-full w-full origin-top bg-amber"></span>
          </div>
          <p data-reveal class="kicker mb-4 text-amber">{skills.depthKicker}</p>
          <h2 data-reveal="title" style="--d:70ms" class="h-sec">{skills.depthTitle}</h2>
          <p data-reveal style="--d:140ms" class="mt-5 max-w-xl text-lg leading-relaxed text-fg-2">{skills.depthNote}</p>

          <div data-reveal style="--d:210ms" class="mt-8 grid grid-cols-5 gap-1 rounded-card border border-border bg-page p-2 font-mono text-[0.5rem] font-semibold uppercase tracking-wide text-muted sm:gap-2 sm:text-[0.58rem]">
            {skills.scale.map((label, index) => (
              <span class:list={["rounded-xl px-1 py-2.5 text-center", index === 4 && "bg-fg text-page"]}>{label}</span>
            ))}
          </div>
        </aside>

        <div class="flex flex-col">
          {
            skills.skills.map((skill, index) => (
              <article data-skill-row data-level={skill.level} class="skill-row border-t border-border py-8 first:border-t-0 first:pt-0 lg:py-10">
                <div class="grid gap-5 sm:grid-cols-[1fr_auto] sm:items-end">
                  <div>
                    <div class="mb-2 flex items-center gap-2.5">
                      <span class={`h-2 w-2 rounded-full ${skillTone[skill.tone]}`}></span>
                      <span class="font-mono text-[0.68rem] font-semibold uppercase tracking-widest text-muted">{skill.category}</span>
                    </div>
                    <h3 class="display text-2xl text-fg sm:text-3xl">{skill.name}</h3>
                  </div>
                  <div class="sm:text-right">
                    <span class="font-mono text-xs font-bold uppercase tracking-wider text-fg">{skill.levelLabel}</span>
                    <span class="ml-2 font-mono text-xs text-muted">{skill.level}/5</span>
                  </div>
                </div>

                <meter
                  class="sr-only"
                  min="1"
                  max="5"
                  value={skill.level}
                  aria-label={`${skill.name}: ${skill.levelLabel}, ${skill.level}/5`}
                >
                  {skill.level} / 5
                </meter>

                <div class="mt-5 grid grid-cols-5 gap-2" aria-hidden="true">
                  {
                    Array.from({ length: 5 }, (_, segment) => (
                      <span class="skill-track-segment">
                        {segment < skill.level && <span data-skill-fill class={`skill-fill ${skillTone[skill.tone]}`}></span>}
                      </span>
                    ))
                  }
                </div>

                <p data-skill-proof class="mt-4 flex items-start gap-2.5 text-sm leading-relaxed text-fg-2">
                  <span class="mt-[0.45rem] h-1 w-1 shrink-0 rounded-full bg-amber"></span>
                  {skill.proof}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sect-sm">
      <div class="wrap">
        <div class="band relative overflow-hidden bg-amber px-8 py-16 text-fg sm:px-14 sm:py-20">
          <div aria-hidden="true" class="shape h-48 w-48 bg-white/35 -right-8 -top-12" data-parallax="-0.18"></div>
          <div class="relative z-10 max-w-3xl">
            <p data-reveal class="kicker mb-4 text-fg/60">{skills.proofKicker}</p>
            <h2 data-reveal="title" style="--d:70ms" class="h-sec text-fg">{skills.proofTitle}</h2>
            <a
              data-reveal
              style="--d:140ms"
              href={`${base}/work/`}
              data-magnetic
              class="mt-8 inline-flex items-center gap-2 rounded-pill bg-fg px-5 py-3 text-sm font-bold text-page transition hover:bg-white hover:text-fg"
            >
              {skills.cta} <span class="arrow-nudge">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .skill-orbit {
    aspect-ratio: 1;
    padding: clamp(1.75rem, 5vw, 3.5rem);
  }

  .skill-orbit-ring {
    position: relative;
    width: 100%;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background:
      radial-gradient(circle at center, color-mix(in srgb, var(--color-purple) 45%, transparent) 0 24%, transparent 25%),
      color-mix(in srgb, var(--color-surface) 78%, transparent);
    box-shadow: 0 40px 80px -55px rgba(17, 17, 20, 0.55);
    will-change: transform;
  }

  .skill-orbit-dash {
    position: absolute;
    inset: 16%;
    border: 1px dashed color-mix(in srgb, var(--color-fg-2) 28%, transparent);
    border-radius: 999px;
  }

  .skill-orbit-core {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 8.5rem;
    height: 8.5rem;
    place-content: center;
    border-radius: 999px;
    background: var(--color-fg);
    text-align: center;
    transform: translate(-50%, -50%);
    box-shadow: 0 22px 55px -30px rgba(17, 17, 20, 0.75);
  }

  .orbit-chip {
    white-space: nowrap;
    will-change: transform;
  }

  .skill-track-segment {
    position: relative;
    height: 0.72rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-soft);
  }

  .skill-fill {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    transform-origin: left center;
    will-change: transform;
  }

  .skill-row {
    will-change: transform, opacity;
  }

  @media (max-width: 639px) {
    .skill-orbit {
      padding: 2.25rem;
    }

    .skill-orbit-core {
      width: 7rem;
      height: 7rem;
    }

    .orbit-chip {
      max-width: 8.75rem;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-orbit-ring,
    .orbit-chip,
    .skill-fill,
    .skill-row {
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>
