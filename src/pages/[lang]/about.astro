---
import type { Lang, StatTone } from "../../i18n/content";
import { CONTENT, LANGS, LINKS } from "../../i18n/content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import AboutMascotPet from "../../components/mascot/AboutMascotPet.tsx";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = CONTENT[lang];
const a = t.about;
const base = `/${lang}`;
const title = `${a.kicker} — Recep Özgür Mıh`;

const factTone: Record<StatTone, string> = {
  amber: "bg-amber text-fg",
  coral: "bg-coral text-white",
  blue: "bg-blue text-white",
  lime: "bg-lime text-fg",
  purple: "bg-purple text-fg",
  white: "bg-surface text-fg",
  soft: "bg-soft text-fg",
};

const storyTone = [
  "bg-amber text-fg md:col-span-7",
  "border border-border bg-surface text-fg md:col-span-5",
  "bg-blue text-white md:col-span-12",
];
---

<Base lang={lang} page="about" title={title} description={a.lead}>
  <Nav lang={lang} active="about" />
  <AboutMascotPet client:only="react" lang={lang} />
  <main>
    <!-- personal hero -->
    <section data-about-hero class="relative overflow-hidden">
      <div aria-hidden="true" class="shape h-52 w-52 bg-lime/70 -left-24 top-20" data-parallax="-0.15"></div>
      <div aria-hidden="true" class="shape h-72 w-72 bg-purple/55 -right-28 top-8" data-parallax="0.18"></div>

      <div class="wrap relative z-10 grid min-h-[calc(88vh-76px)] items-center gap-12 py-14 lg:grid-cols-[1.06fr_0.94fr] lg:py-20">
        <header class="max-w-4xl">
          <div data-reveal class="mb-6 flex flex-wrap items-center gap-3">
            <p class="kicker text-amber">{a.kicker}</p>
            <span class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface px-3 py-1.5 text-xs font-bold text-fg-2">
              <span class="status-dot h-2 w-2 rounded-full bg-lime text-lime"></span>
              {a.availability}
            </span>
          </div>
          <h1 data-reveal="title" style="--d:70ms" class="h-hero">{a.title}</h1>
          <p data-reveal style="--d:150ms" class="mt-6 max-w-2xl text-xl leading-relaxed text-fg-2">{a.lead}</p>
          <div data-reveal style="--d:220ms" class="mt-9 flex flex-wrap gap-3">
            <a href={`${base}/contact/`} data-mascot="contact" data-magnetic class="inline-flex items-center gap-2 rounded-pill bg-fg px-5 py-3 text-sm font-bold text-page transition hover:bg-amber hover:text-fg">
              {t.hero.ctaContact} <span class="arrow-nudge">→</span>
            </a>
            <a href={LINKS.cv} target="_blank" rel="noopener" data-mascot="cv" data-magnetic class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface px-5 py-3 text-sm font-bold text-fg transition hover:border-fg/30">
              {t.contact.ctaCV} ↗
            </a>
          </div>
        </header>

        <div data-reveal="scale" style="--d:170ms" class="about-portrait-wrap mx-auto w-full max-w-[500px]">
          <div data-about-portrait class="about-portrait relative overflow-hidden rounded-huge bg-blue">
            <span class="absolute left-7 top-7 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-white/55">01 / RECEP</span>
            <div aria-hidden="true" class="shape h-44 w-44 bg-amber -right-12 top-12"></div>
            <div aria-hidden="true" class="shape h-24 w-24 bg-lime left-10 bottom-24"></div>
            <!-- dock anchor: the pet (rendered viewport-fixed below) tracks this
                 box while docked. A hidden sizer keeps the slot's real size. -->
            <div
              data-about-person
              class="pointer-events-none absolute bottom-0 left-1/2 h-[88%] w-auto max-w-none -translate-x-1/2"
            >
              <img src="/mascot/idle.webp" alt="" draggable="false" class="h-full w-auto max-w-none object-contain opacity-0" />
            </div>
            <div data-about-note class="absolute right-5 bottom-5 left-5 rounded-card2 bg-surface/95 p-5 shadow-[0_22px_45px_-26px_rgba(17,17,20,0.55)] backdrop-blur">
              <p class="text-sm font-semibold leading-relaxed text-fg">{a.portraitNote}</p>
              <span class="mt-3 block font-mono text-[0.65rem] font-bold uppercase tracking-widest text-amber">Recep Özgür Mıh</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- quick personal facts -->
    <section class="relative z-20 -mt-2 pb-10 sm:-mt-8">
      <div class="wrap grid grid-cols-2 gap-3 lg:grid-cols-4">
        {a.facts.map((fact, index) => (
          <article data-mascot-floor data-reveal="scale" style={`--d:${index * 65}ms`} class:list={["min-h-36 rounded-card2 p-5 sm:p-6", factTone[fact.tone]]}>
            <strong class="display block text-2xl leading-none sm:text-3xl">{fact.value}</strong>
            <p class="mt-3 max-w-[13rem] text-sm font-semibold leading-snug opacity-75">{fact.label}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- character through work -->
    <section class="sect-sm">
      <div class="wrap">
        <header data-reveal class="mb-12 max-w-3xl">
          <p class="kicker mb-3 text-amber">{a.storyKicker}</p>
          <h2 class="h-sec">{a.storyTitle}</h2>
        </header>

        <div class="grid gap-5 md:grid-cols-12">
          {a.story.map((item, index) => (
            <article
              data-mascot-bin
              data-reveal="scale"
              data-tilt
              style={`--d:${index * 80}ms`}
              class:list={["min-h-[310px] rounded-show p-7 sm:p-10", storyTone[index]]}
            >
              <div class="flex h-full flex-col justify-between gap-12">
                <span class="font-mono text-xs font-bold tracking-widest opacity-55">0{index + 1}</span>
                <div class="max-w-2xl">
                  <h3 class="display text-3xl sm:text-4xl">{item.title}</h3>
                  <p class="mt-4 text-lg leading-relaxed opacity-80">{item.body}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- personal notes -->
    <section class="sect-sm">
      <div data-mascot-bin class="full bg-night py-20 text-white sm:py-28">
        <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <header data-reveal class="max-w-xl">
            <p class="kicker mb-4 text-amber">{a.notesKicker}</p>
            <h2 class="h-sec text-white">{a.notesTitle}</h2>
          </header>
          <div class="flex flex-col">
            {a.notes.map((note, index) => (
              <p data-reveal="left" style={`--d:${index * 70}ms`} class="flex gap-4 border-t border-white/15 py-6 text-lg leading-relaxed text-white/80 first:border-t-0 first:pt-0 sm:text-xl">
                <span class="font-mono text-xs font-bold text-amber">0{index + 1}</span>
                {note}
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- community + education -->
    <section class="sect-sm">
      <div class="wrap grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
        <header data-reveal data-mascot="community" class="max-w-xl">
          <p class="kicker mb-3 text-amber">{a.communityKicker}</p>
          <h2 class="h-sec">{a.communityTitle}</h2>
        </header>

        <div class="flex flex-col">
          {a.community.map((item, index) => (
            <article data-reveal="left" style={`--d:${index * 70}ms`} class="grid gap-4 border-t border-border py-8 sm:grid-cols-[1fr_auto]">
              <div>
                <h3 class="text-xl font-bold text-fg">{item.org}</h3>
                <p class="mt-1 font-semibold text-amber">{item.role}</p>
                <p class="mt-3 max-w-2xl leading-relaxed text-fg-2">{item.line}</p>
              </div>
              <span class="font-mono text-xs font-semibold text-muted sm:text-right">{item.period}</span>
            </article>
          ))}

          <a href={`${base}/profile/#academic`} data-reveal="left" data-mascot="academic" class="group grid gap-4 border-y border-border py-8 sm:grid-cols-[1fr_auto]">
            <div>
              <h3 class="text-xl font-bold text-fg">{a.education.degree}</h3>
              <p class="mt-1.5 text-fg-2">{a.education.school}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-amber">
                {lang === "tr" ? "Akademik yolculuğu gör" : "See the academic journey"}
                <span class="arrow-nudge">→</span>
              </span>
            </div>
            <span class="font-mono text-xs font-semibold text-muted sm:text-right">{a.education.period}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- next steps -->
    <section class="sect-sm pt-0">
      <div class="wrap grid gap-5 lg:grid-cols-2">
        <a href={`${base}/profile/#technical`} data-mascot-bin data-reveal="scale" data-spotlight class="group flex min-h-[320px] flex-col justify-between rounded-show bg-purple p-8 text-fg sm:p-10">
          <div>
            <p class="kicker mb-4 text-fg/55">{a.skillsCta.kicker}</p>
            <h2 class="display max-w-xl text-3xl sm:text-4xl">{a.skillsCta.title}</h2>
            <p class="mt-4 max-w-lg leading-relaxed text-fg/70">{a.skillsCta.note}</p>
          </div>
          <span class="mt-10 inline-flex items-center gap-2 text-sm font-bold">
            {a.skillsCta.cta} <span class="arrow-nudge">→</span>
          </span>
        </a>

        <a href={`${base}/contact/`} data-mascot-bin data-reveal="scale" data-mascot="contact" class="group flex min-h-[320px] flex-col justify-between rounded-show bg-coral p-8 text-white sm:p-10">
          <div>
            <p class="kicker mb-4 text-white/65">{a.contactCta.kicker}</p>
            <h2 class="display max-w-xl text-3xl sm:text-4xl">{a.contactCta.title}</h2>
          </div>
          <span class="mt-10 inline-flex items-center gap-2 text-sm font-bold">
            {a.contactCta.cta} <span class="arrow-nudge">→</span>
          </span>
        </a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .about-portrait-wrap {
    perspective: 1000px;
  }

  .about-portrait {
    aspect-ratio: 0.88;
    min-height: 520px;
    box-shadow: 0 45px 85px -52px rgba(17, 17, 20, 0.65);
    will-change: transform;
  }

  [data-about-person],
  [data-about-note] {
    will-change: transform;
  }

  @media (max-width: 639px) {
    .about-portrait {
      aspect-ratio: auto;
      min-height: 460px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-portrait,
    [data-about-person],
    [data-about-note] {
      transform: none !important;
    }
  }
</style>
