---
import type { Lang, StatTone } from "../../i18n/content";
import { CONTENT, LANGS } from "../../i18n/content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = CONTENT[lang];
const labs = t.labsPage;
const title = `${labs.kicker} — Recep Özgür Mıh`;
const total = labs.groups.reduce((n, g) => n + g.items.length, 0);

// small colour accent per category, reusing the site's tone palette
const dot: Record<StatTone, string> = {
  amber: "bg-amber",
  coral: "bg-coral",
  blue: "bg-blue",
  lime: "bg-lime",
  purple: "bg-purple",
  white: "bg-fg",
  soft: "bg-muted",
};
const ring: Record<StatTone, string> = {
  amber: "group-hover:border-amber",
  coral: "group-hover:border-coral",
  blue: "group-hover:border-blue",
  lime: "group-hover:border-lime",
  purple: "group-hover:border-purple",
  white: "group-hover:border-fg",
  soft: "group-hover:border-muted",
};
---

<Base lang={lang} page="labs" title={title} description={labs.note}>
  <Nav lang={lang} active="labs" />
  <main>
    <!-- HEADER -->
    <section class="relative overflow-hidden">
      <div aria-hidden="true" class="shape h-64 w-64 bg-lime/60 -right-16 top-4" data-parallax="0.2"></div>
      <div aria-hidden="true" class="shape h-32 w-32 bg-purple/60 left-[42%] top-24" data-parallax="-0.16"></div>
      <div class="wrap relative z-10 py-16 sm:py-20 lg:py-24">
        <p data-reveal class="kicker mb-3 text-amber">{labs.kicker} · {total}</p>
        <h1 data-reveal="title" style="--d:70ms" class="h-hero max-w-4xl text-balance">{labs.title}</h1>
        <p data-reveal style="--d:150ms" class="mt-6 max-w-2xl text-xl leading-relaxed text-fg-2">{labs.note}</p>
      </div>
    </section>

    <!-- GROUPS -->
    <section class="pb-20 sm:pb-28">
      <div class="wrap flex flex-col gap-16">
        {
          labs.groups.map((group, gi) => (
            <div>
              <header data-reveal class="mb-6 flex items-center gap-3">
                <span class={`h-2.5 w-2.5 rounded-full ${dot[group.tone]}`} />
                <h2 class="display text-xl text-fg sm:text-2xl">{group.name}</h2>
                <span class="font-mono text-xs text-muted">{group.items.length}</span>
                <span class="ml-1 h-px flex-1 bg-border" />
              </header>

              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {group.items.map((item, ii) => (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-reveal="scale"
                    data-spotlight
                    style={`--d:${Math.min(gi * 60 + ii * 45, 500)}ms`}
                    class={`group flex items-center justify-between gap-4 rounded-card2 border border-border bg-surface p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_46px_-26px_rgba(17,17,20,0.3)] ${ring[group.tone]}`}
                  >
                    <span class="min-w-0">
                      <span class="block truncate font-bold text-fg">{item.name}</span>
                      <span class="mt-0.5 block truncate text-sm text-fg-2">{item.desc}</span>
                    </span>
                    <span
                      aria-hidden="true"
                      class={`grid h-9 w-9 shrink-0 place-items-center rounded-full border border-border text-fg-2 transition-colors group-hover:text-fg ${ring[group.tone]}`}
                    >
                      <span class="arrow-nudge">↗</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }

        <p data-reveal class="font-mono text-xs text-muted">
          {lang === "tr"
            ? "Not: bunlar erken dönem denemeleri — yeni sekmede eski adreslerinde açılır."
            : "Note: these are early experiments — they open in a new tab at their old URLs."}
        </p>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
