---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { formatDate, readingMinutes, sortPosts } from "../../lib/blog";

const posts = sortPosts(await getCollection("blog", ({ data }) => !data.draft));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post.id !== featured?.id);
const canonical = "https://recepozgur.com/blog/";
const tones = ["bg-amber", "bg-blue", "bg-coral", "bg-lime"];
---

<Base
  lang="tr"
  page="blog"
  title="Blog — Recep Özgür Mıh"
  description="Mobile, backend, API design ve AI engineering üzerine production odaklı teknik notlar."
  canonical={canonical}
  alternates={[{ lang: "tr", href: canonical }, { lang: "x-default", href: canonical }]}
>
  <Nav lang="tr" active="blog" />

  <main>
    {featured && (
      <section class="sect-sm">
        <div class="wrap">
          <div class="mb-8 flex items-end justify-between gap-5">
            <div>
              <p class="kicker mb-3 text-amber">Son yazı</p>
              <h1 class="display text-3xl sm:text-4xl">Öne çıkan</h1>
            </div>
            <a href="/rss.xml" class="hidden font-mono text-xs font-semibold text-fg-2 transition hover:text-amber sm:block">RSS ↗</a>
          </div>

          <a href={`/blog/${featured.data.slug}/`} class="group grid overflow-hidden rounded-show bg-night text-white lg:grid-cols-[0.8fr_1.2fr]">
            <div class="relative min-h-72 overflow-hidden border-b border-white/10 lg:min-h-[430px] lg:border-r lg:border-b-0">
              <img src={featured.data.heroImage} alt={featured.data.heroAlt} width="1200" height="630" loading="eager" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent"></div>
              <span class="absolute bottom-7 left-7 rounded-pill bg-black/65 px-3 py-1.5 font-mono text-[0.65rem] font-bold uppercase tracking-widest text-white backdrop-blur-sm">{featured.data.category}</span>
            </div>
            <article class="flex min-h-[430px] flex-col justify-between p-8 sm:p-10 lg:p-14">
              <div>
                <p class="font-mono text-xs font-semibold text-white/55">{formatDate(featured.data.publishedAt)} · {readingMinutes(featured.body ?? "")} dk</p>
                <h2 class="display mt-7 max-w-3xl text-3xl leading-tight text-white sm:text-5xl">{featured.data.title}</h2>
                <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/65">{featured.data.description}</p>
                <div class="mt-7 flex flex-wrap gap-2">
                  {featured.data.tags.slice(0, 3).map((tag) => <span class="rounded-pill border border-white/15 px-3 py-1.5 font-mono text-[0.65rem] font-semibold text-white/65">#{tag}</span>)}
                </div>
              </div>
              <span class="mt-10 inline-flex items-center gap-2 font-bold text-amber">Yazıyı oku <span class="arrow-nudge">→</span></span>
            </article>
          </a>
        </div>
      </section>
    )}

    {rest.length > 0 && (
      <section class="sect-sm pt-0">
        <div class="wrap">
          <header class="mb-10">
            <p class="kicker mb-3 text-amber">Arşiv</p>
            <h2 class="h-sec">Diğer yazılar</h2>
          </header>
          <div class="grid gap-x-7 gap-y-14 lg:grid-cols-2 lg:gap-x-8 lg:gap-y-16">
            {rest.map((post, index) => (
              <a href={`/blog/${post.data.slug}/`} data-reveal style={`--d:${index * 60}ms`} class="group block">
                <div class="aspect-video overflow-hidden bg-soft">
                  <img src={post.data.heroImage} alt={post.data.heroAlt} width="1200" height="630" loading="lazy" class="h-full w-full object-contain transition duration-500 group-hover:scale-[1.02]" />
                </div>
                <article class="pt-6">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <span class="flex items-center gap-2">
                      <span class:list={["h-2 w-2 rounded-full", tones[index % tones.length]]}></span>
                      <span class="font-mono text-[0.65rem] font-bold uppercase tracking-widest text-fg-2">{post.data.category}</span>
                    </span>
                    <span class="text-border">/</span>
                    <span class="font-mono text-[0.68rem] font-semibold text-muted">{formatDate(post.data.publishedAt)} · {readingMinutes(post.body ?? "")} dk</span>
                  </div>
                  <div class="mt-5 flex items-start justify-between gap-6">
                    <h3 class="display text-2xl leading-tight transition-colors group-hover:text-amber sm:text-3xl">{post.data.title}</h3>
                    <span class="shrink-0 text-xl text-fg transition-transform group-hover:translate-x-1">→</span>
                  </div>
                  <p class="mt-4 max-w-xl leading-relaxed text-fg-2">{post.data.description}</p>
                </article>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer lang="tr" />
</Base>
