---
import type { Lang, StatTone } from "../../i18n/content";
import { CONTENT, LANGS, LINKS } from "../../i18n/content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Marquee from "../../components/Marquee.astro";
import HeroScene from "../../components/HeroScene.astro";
import Paint from "../../components/Paint.astro";
import ProjectPreviewCard from "../../components/ProjectPreviewCard.astro";
import Caps from "../../components/Caps.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = CONTENT[lang];
const base = `/${lang}`;

const tone: Record<StatTone, string> = {
  amber: "bg-amber text-fg",
  coral: "bg-coral text-white",
  blue: "bg-blue text-white",
  lime: "bg-lime text-fg",
  purple: "bg-purple text-fg",
  white: "bg-surface text-fg border border-border",
  soft: "bg-soft text-fg",
};
const peek = t.stats.items.slice(0, 4);
---

<Base lang={lang} page="home">
  <Nav lang={lang} />
  <main>
    <!-- HERO -->
    <section data-hero class="relative overflow-hidden">
      <div aria-hidden="true" class="shape h-[28rem] w-[28rem] bg-purple/50 -right-40 -top-24" data-parallax="0.18"></div>
      <div aria-hidden="true" class="shape h-40 w-40 bg-lime/70 left-[44%] top-24" data-parallax="-0.16"></div>

      <div class="wrap relative z-10 flex min-h-[calc(100vh-76px)] flex-col">
        <div class="grid flex-1 items-center gap-10 py-10 lg:grid-cols-[1.05fr_0.95fr]">
          <!-- copy -->
          <div data-hero-copy>
            <div data-reveal style="--d:0ms" class="mb-7 inline-flex w-fit items-center gap-2 rounded-pill border border-border bg-surface px-3.5 py-1.5 text-sm font-semibold text-fg-2 shadow-sm">
              <span class="status-dot h-2 w-2 rounded-full bg-amber text-amber"></span>
              {t.hero.pill}
            </div>
            <h1 data-reveal="title" style="--d:90ms" class="h-hero text-balance text-fg">{t.hero.headline}</h1>
            <p data-reveal style="--d:180ms" class="mt-7 max-w-xl text-xl leading-relaxed text-fg-2">{t.hero.sub}</p>
            <div data-reveal style="--d:260ms" class="mt-10 flex flex-wrap items-center gap-3">
              <a href={`${base}/work/`} data-mascot="work" data-magnetic class="btn-amber inline-flex items-center gap-2 rounded-pill bg-fg px-6 py-3.5 text-base font-bold text-page transition hover:bg-amber hover:text-fg">
                {t.hero.ctaWork} <span class="arrow-nudge">→</span>
              </a>
              <a href={`${base}/contact/`} data-mascot="contact" data-magnetic class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface px-6 py-3.5 text-base font-bold text-fg transition hover:border-fg/30">
                {t.hero.ctaContact}
              </a>
              <a href={LINKS.cv} target="_blank" rel="noopener" data-mascot="cv" class="ul ml-1 text-sm font-semibold text-fg-2 transition hover:text-fg">{t.hero.ctaCV} ↗</a>
            </div>
            <div data-reveal style="--d:340ms" class="mt-8 pb-14 sm:pb-16">
              <div class="inline-flex flex-wrap items-center gap-x-4 gap-y-2 rounded-card border border-border bg-surface/90 px-4 py-3 font-mono text-[0.68rem] font-semibold text-fg-2 shadow-sm">
                <span class="inline-flex items-center gap-2"><i class="h-2 w-2 rounded-full bg-lime"></i>{t.hero.status}</span>
                <span class="text-border">/</span>
                <span>{t.hero.location}</span>
                <span class="text-border">/</span>
                <a href={LINKS.github} target="_blank" rel="noopener" data-mascot="github" class="ul transition hover:text-amber">GitHub ↗</a>
                <a href={LINKS.linkedin} target="_blank" rel="noopener" data-mascot="linkedin" class="ul transition hover:text-amber">LinkedIn ↗</a>
              </div>
            </div>
          </div>

          <!-- scene -->
          <div data-hero-scene class="hidden lg:block">
            <div data-reveal="scale" style="--d:160ms">
              <HeroScene lang={lang} />
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- PROOF CARDS + TECH MARQUEE: one shared diagonal ribbon -->
    <div class="showcase-ribbon">
      <div class="wrap relative z-10">
        <div class="hero-proof-cards -mb-px grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
          {
            peek.map((s, i) => (
              <div data-reveal="scale" style={`--d:${420 + i * 55}ms`} class:list={["rounded-card2 px-5 pt-5 pb-9", tone[s.tone]]}>
                <div data-count class="display text-2xl leading-none sm:text-3xl">{s.value}</div>
                <div class="mt-1.5 text-xs font-semibold opacity-80">{s.label}</div>
              </div>
            ))
          }
        </div>
      </div>
      <Marquee lang={lang} />
    </div>

    <!-- FEATURED -->
    <section id="work" class="sect-sm">
      <div class="wrap">
        <header data-reveal class="mb-12 max-w-2xl">
          <p class="kicker mb-3 text-amber">{t.featured.kicker}</p>
          <h2 class="h-sec">{t.featured.title}</h2>
          <p class="mt-4 text-lg text-fg-2">{t.featured.note}</p>
        </header>
        <div class="flex flex-col gap-6">
          {t.projects.map((p, i) => <ProjectPreviewCard lang={lang} project={p} index={i} />)}
        </div>
        <div data-reveal class="mt-8">
          <a href={`${base}/work/`} data-magnetic class="inline-flex items-center gap-2 rounded-pill border border-border bg-surface px-5 py-3 text-sm font-bold text-fg transition hover:border-fg/30">
            {t.featured.all} <span class="arrow-nudge">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CIRCLE-WIPE: projects → how I ship → capabilities -->
    <Paint
      kicker={t.paint.kicker}
      title={t.paint.title}
      sub={t.paint.sub}
      steps={t.paint.steps}
      nextKicker={t.capsTeaser.kicker}
      nextTitle={t.capsTeaser.title}
    />

    <!-- CAPABILITIES -->
    <section id="skills" aria-labelledby="home-skills-heading" class="sect-sm scroll-mt-24 pt-8">
      <div class="wrap">
        <Caps lang={lang} />
        <a href={`${base}/profile/#technical`} data-reveal data-magnetic class="mt-8 inline-flex items-center gap-2 rounded-pill border border-border bg-surface px-5 py-3 text-sm font-bold text-fg transition hover:border-fg/30">
          {t.capsTeaser.more} <span class="arrow-nudge">→</span>
        </a>
      </div>
    </section>

    <!-- CONTACT CTA (colored, not dark) -->
    <section class="sect-sm">
      <div class="wrap">
        <div class="contact-cta band bg-coral px-8 py-20 text-center text-white sm:px-16 sm:py-28">
          <div aria-hidden="true" class="shape h-60 w-60 bg-amber -left-12 -bottom-16" data-parallax="0.22"></div>
          <div aria-hidden="true" class="shape h-32 w-32 bg-blue -right-6 top-8" data-parallax="-0.2"></div>
          <div aria-hidden="true" class="shape h-20 w-20 bg-white/30 right-1/4 bottom-1/4" data-parallax="0.3"></div>
          <p data-reveal class="kicker relative z-10 mb-4 text-white/80">{t.homeContact.kicker}</p>
          <h2 data-reveal style="--d:80ms" class="h-sec relative z-10 mx-auto max-w-2xl text-white">{t.homeContact.title}</h2>
          <div data-reveal style="--d:160ms" class="relative z-10 mt-9">
            <a href={`${base}/contact/`} data-mascot="contact" data-magnetic class="inline-flex items-center gap-2 rounded-pill bg-white px-7 py-4 text-base font-bold text-fg transition hover:bg-fg hover:text-page">
              {t.homeContact.cta} <span class="arrow-nudge">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
