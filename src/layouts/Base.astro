---
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import MascotIsland from "../components/mascot/MascotIsland.tsx";
import type { Lang } from "../i18n/content";
import { CONTENT } from "../i18n/content";

interface Props {
  lang: Lang;
  page: string; // data-page key (home | work | about | contact | project:<slug>)
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  alternates?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const {
  lang,
  page,
  title,
  description,
  canonical,
  ogImage,
  type = "website",
  publishedTime,
  updatedTime,
  alternates,
  jsonLd,
  noindex = false,
} = Astro.props;
const t = CONTENT[lang];
const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = ogImage ? new URL(ogImage, Astro.site ?? Astro.url.origin).toString() : undefined;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
// Trailing slash tutarlılığı: site trailing slash kullanıyor.
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
// /tr/... veya /en/... yolunu yakala; rest her zaman "/" ile başlar ve "/" ile biter.
const langSegment = currentPath.match(/^\/(tr|en)(\/.*)?$/);
const buildAlternates = () => {
  if (!langSegment) {
    // Dil segmenti olmayan sayfalar (/, /blog/..., /cv/): mevcut davranış.
    return [
      { lang: "en", href: new URL("/en/", siteOrigin).toString() },
      { lang: "tr", href: new URL("/tr/", siteOrigin).toString() },
      { lang: "x-default", href: new URL("/en/", siteOrigin).toString() },
    ];
  }
  const rest = langSegment[2] ?? "/";
  const enHref = new URL(`/en${rest}`, siteOrigin).toString();
  const trHref = new URL(`/tr${rest}`, siteOrigin).toString();
  // Self-referencing hreflang dahil (sayfa kendi dilini de bildirir).
  return [
    { lang: "en", href: enHref },
    { lang: "tr", href: trHref },
    { lang: "x-default", href: enHref },
  ];
};
// Sayfa açıkça alternates geçtiyse (blog sayfaları) o öncelikli.
const pageAlternates = alternates ?? buildAlternates();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="author" content="Recep Özgür Mıh" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Recep Özgür Mıh — Teknik Blog"
      href="/rss.xml"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={pageTitle} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    {pageAlternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />
  </head>
  <body data-page={page}>
    <slot />
    {!page.startsWith("blog:") && <MascotIsland lang={lang} client:only="react" transition:persist="mascot" />}
    <script>
      import "../scripts/ui.ts";
      import "../scripts/scroll.ts";
    </script>
  </body>
</html>
