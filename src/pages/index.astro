---
// Root → language gateway. Static-friendly client redirect with language sniff.
// Indexable: crawlers get real content + a canonical to /tr/, humans with JS
// are redirected before any of it paints.
import { CONTENT } from "../i18n/content";

const trDesc = CONTENT.tr.meta.description;
const enDesc = CONTENT.en.meta.description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recep Özgür Mıh</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={trDesc} />
    <link rel="canonical" href="https://recepozgur.com/tr/" />
    <link rel="alternate" hreflang="en" href="https://recepozgur.com/en/" />
    <link rel="alternate" hreflang="tr" href="https://recepozgur.com/tr/" />
    <link rel="alternate" hreflang="x-default" href="https://recepozgur.com/en/" />
    <script is:inline>
      (function () {
        var lang = (navigator.language || "en").toLowerCase().startsWith("tr")
          ? "tr"
          : "en";
        window.location.replace("/" + lang + "/");
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url=/en/" />
    </noscript>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #fafaf7;
        color: #667085;
        font-family: ui-monospace, monospace;
      }
      .c {
        display: grid;
        place-items: center;
        height: 100%;
        gap: 1rem;
        font-size: 0.8rem;
        letter-spacing: 0.1em;
      }
      .d {
        width: 8px;
        height: 8px;
        border-radius: 99px;
        background: #f59e0b;
        animation: p 1s ease-in-out infinite;
      }
      @keyframes p {
        0%,
        100% {
          opacity: 0.3;
        }
        50% {
          opacity: 1;
        }
      }
      .c h1 {
        margin: 0;
        font-size: 1.1rem;
        letter-spacing: 0.04em;
        color: #1d2939;
      }
      .c p {
        margin: 0;
        max-width: 38rem;
        padding: 0 1.5rem;
        text-align: center;
        line-height: 1.6;
        letter-spacing: 0;
      }
      .c a {
        color: #f59e0b;
      }
    </style>
  </head>
  <body>
    <div class="c">
      <span class="d"></span>
      <h1>Recep Özgür Mıh</h1>
      <p>{trDesc}</p>
      <p lang="en">{enDesc}</p>
      <p>
        <a href="/tr/">Türkçe</a> ·
        <a href="/en/">English</a>
      </p>
      <span>Redirecting · Yönlendiriliyor…</span>
    </div>
  </body>
</html>
