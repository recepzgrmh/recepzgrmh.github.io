# ---------------------------------------------------------------------------
# Mascot chat — connect the fine-tuned "Recep" model.
# Leave BOTH unset to keep the chat in DEMO mode (canned, streamed replies).
#
# When your model is ready, serve it behind an OpenAI-compatible
# /v1/chat/completions endpoint (Ollama, vLLM, LM Studio, TGI all do this),
# copy this file to `.env`, and fill these in. No code changes needed.
#
# NOTE: PUBLIC_* vars are shipped to the browser. Only use a public, keyless
# endpoint here. If the endpoint needs a secret, add a serverless proxy instead
# and point PUBLIC_MASCOT_CHAT_URL at the proxy — never put the key in PUBLIC_*.
#
# Local dev with Ollama also needs CORS, e.g.:  OLLAMA_ORIGINS=* ollama serve
# ---------------------------------------------------------------------------

PUBLIC_MASCOT_CHAT_URL=
PUBLIC_MASCOT_CHAT_MODEL=

# Examples:
# PUBLIC_MASCOT_CHAT_URL=http://localhost:11434/v1/chat/completions
# PUBLIC_MASCOT_CHAT_MODEL=recep-qwen

# ---------------------------------------------------------------------------
# Spotify "now playing" — footer card.
# The OAuth dance (client secret + refresh token) already runs server-side in a
# Cloudflare Worker; the site only reads its JSON. The worker URL is hardcoded as
# a default in NowPlaying.tsx, so you only need this if the worker ever moves.
# ---------------------------------------------------------------------------
# PUBLIC_SPOTIFY_NOW_PLAYING_URL=https://spotify-worker.recepzgrmh.workers.dev/
