---
import type { Lang } from "../../../i18n/content";
import { CONTENT, LANGS } from "../../../i18n/content";
import Base from "../../../layouts/Base.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import ProjectPreviewCard from "../../../components/ProjectPreviewCard.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = CONTENT[lang];
const title = `${t.workIndex.title} — Recep Özgür Mıh`;
---

<Base lang={lang} page="work" title={title} description={t.workIndex.note}>
  <Nav lang={lang} active="work" />
  <main>
    <section class="relative overflow-hidden">
      <div aria-hidden="true" class="shape h-56 w-56 bg-purple/50 -right-12 top-0" data-parallax="0.2"></div>
      <div class="wrap relative z-10 pt-20 pb-10 sm:pt-28">
        <header class="max-w-3xl">
          <p data-reveal class="kicker mb-3 text-amber">{t.workIndex.kicker}</p>
          <h1 data-reveal="title" style="--d:70ms" class="h-hero">{t.workIndex.title}</h1>
          <p data-reveal style="--d:150ms" class="mt-5 text-xl text-fg-2">{t.workIndex.note}</p>
        </header>
      </div>
    </section>

    <section class="sect-sm pt-6">
      <div class="wrap flex flex-col gap-6">
        {t.projects.map((p, i) => <ProjectPreviewCard lang={lang} project={p} index={i} />)}
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
