---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { sortPosts } from "../../lib/blog";

const posts = sortPosts(await getCollection("blog", ({ data }) => !data.draft));
const [featured, ...rest] = posts;
const canonical = "https://recepozgur.com/blog/";
---

<Base
  lang="tr"
  page="blog"
  title="Teknik Blog — Recep Özgür Mıh"
  description="Mobil, backend, API, AI ürünleri ve yazılım mimarisi üzerine kaynaklı teknik notlar."
  canonical={canonical}
  alternates={[{ lang: "tr", href: canonical }, { lang: "x-default", href: canonical }]}
>
  <Nav lang="tr" active="blog" />
  <main>
    <section class="relative overflow-hidden border-b border-border">
      <div aria-hidden="true" class="shape -right-32 -top-24 h-80 w-80 bg-purple/55"></div>
      <div aria-hidden="true" class="shape left-[58%] top-12 h-24 w-24 bg-lime/80"></div>
      <div class="wrap relative z-10 py-20 sm:py-28 lg:py-36">
        <p data-reveal class="kicker mb-5 text-amber">Teknik notlar · kaynaklı ve uygulamaya dönük</p>
        <h1 data-reveal="title" style="--d:70ms" class="h-hero max-w-5xl">Bir şeyi ezberlemekten çok, neden öyle çalıştığını anlamaya çalışıyorum.</h1>
        <p data-reveal style="--d:150ms" class="mt-7 max-w-2xl text-lg leading-relaxed text-fg-2 sm:text-xl">
          Mobil geliştirme, backend, API tasarımı ve AI ürünleri üzerine araştırırken aldığım notlar. Büyük iddialar yerine kaynak, trade-off ve uygulanabilir fikirler.
        </p>
      </div>
    </section>

    {featured && (
      <section class="sect-sm">
        <div class="wrap">
          <div data-reveal class="mb-7 flex items-end justify-between gap-6">
            <div>
              <p class="kicker mb-3 text-amber">Öne çıkan</p>
              <h2 class="display text-2xl sm:text-3xl">Son teknik yazı</h2>
            </div>
            <a href="/rss.xml" class="hidden font-mono text-xs font-semibold text-fg-2 transition hover:text-amber sm:block">RSS ↗</a>
          </div>
          <div data-reveal="scale" style="--d:80ms"><BlogCard post={featured} featured /></div>
        </div>
      </section>
    )}

    {rest.length > 0 && (
      <section class="pb-24 sm:pb-32">
        <div class="wrap">
          <header data-reveal class="mb-8">
            <p class="kicker mb-3">Arşiv</p>
            <h2 class="display text-3xl sm:text-4xl">Diğer yazılar</h2>
          </header>
          <div class="grid gap-6 lg:grid-cols-2">
            {rest.map((post, index) => <div data-reveal style={`--d:${index * 60}ms`}><BlogCard post={post} /></div>)}
          </div>
        </div>
      </section>
    )}
  </main>
  <Footer lang="tr" />
</Base>
