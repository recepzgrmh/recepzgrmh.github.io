---
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import MascotIsland from "../components/mascot/MascotIsland.tsx";
import type { Lang } from "../i18n/content";
import { CONTENT } from "../i18n/content";

interface Props {
  lang: Lang;
  page: string; // data-page key (home | work | about | contact | project:<slug>)
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  alternates?: { lang: string; href: string }[];
  jsonLd?: Record<string, unknown>;
}
const {
  lang,
  page,
  title,
  description,
  canonical,
  ogImage,
  type = "website",
  publishedTime,
  updatedTime,
  alternates,
  jsonLd,
} = Astro.props;
const t = CONTENT[lang];
const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImage = ogImage ? new URL(ogImage, Astro.site ?? Astro.url.origin).toString() : undefined;
const defaultAlternates = [
  { lang: "en", href: "https://recepozgur.com/en/" },
  { lang: "tr", href: "https://recepozgur.com/tr/" },
  { lang: "x-default", href: "https://recepozgur.com/en/" },
];
const pageAlternates = alternates ?? defaultAlternates;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="author" content="Recep Özgür Mıh" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={pageTitle} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    {pageAlternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />
  </head>
  <body data-page={page}>
    <slot />
    <MascotIsland lang={lang} client:only="react" transition:persist="mascot" />
    <script>
      import "../scripts/ui.ts";
      import "../scripts/scroll.ts";
    </script>
  </body>
</html>
